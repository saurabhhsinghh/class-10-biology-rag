# Copy this file to `.env` and fill in your real values.
#
# `.env` is gitignored. NEVER commit it, paste it into a chat, or share it.
# If a key ever leaks, rotate it immediately -- a public repo is scraped within
# minutes of a push.

# ---------------------------------------------------------------------------
# Groq -- speech-to-text (Whisper)
# Get one: https://console.groq.com  ->  API Keys  ->  Create API Key
# Free tier, no card required.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Google AI Studio -- Gemini (answer generation)
# Get one: https://aistudio.google.com  ->  Get API key
# Free tier, no card required.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Qdrant Cloud -- vector database
# Get one: https://cloud.qdrant.io  ->  create a free cluster
# Copy the cluster endpoint URL and generate an API key.
# The free 1 GB tier is far more than this project needs.
# ---------------------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
